ARG BASE_IMAGE=ghcr.io/euphorlc/acheron-base:preview
FROM ${BASE_IMAGE}
RUN dnf -y install gcc gcc-c++ make pkgconf-pkg-config openssl-devel \
    && dnf clean all
# Toolchain is image-managed; Cargo's writable cache and installed tools stay
# in the user's separate persistent home (~/.cargo).
RUN curl --proto '=https' --tlsv1.2 -fsS https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup sh /tmp/rustup-init.sh \
       -y --no-modify-path --profile default --default-toolchain 1.100.0 \
    && RUSTUP_HOME=/opt/rustup /opt/cargo/bin/rustup component add rust-analyzer rust-src \
    && chmod -R a+rX /opt/cargo /opt/rustup \
    && rm /tmp/rustup-init.sh
ENV RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:${PATH}
RUN rustc --version && cargo --version && rust-analyzer --version
